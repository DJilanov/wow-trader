{
  "name": "wow-trader",
  "version": "0.1.0",
  "private": true,
  "description": "Build-aware World of Warcraft economy intelligence platform",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.20.0"
  },
  "scripts": {
    "build": "node scripts/build-cache.mjs --run build",
    "clean:build-cache": "node scripts/build-cache.mjs",
    "catalog:audit": "pnpm --filter @wow-trader/catalog dev audit",
    "catalog:assess-promotion": "pnpm --filter @wow-trader/catalog dev assess-promotion",
    "catalog:diff": "pnpm --filter @wow-trader/catalog dev diff",
    "catalog:semantic-diff": "pnpm --filter @wow-trader/catalog dev semantic-diff",
    "catalog:import": "pnpm --filter @wow-trader/catalog dev import",
    "catalog:guardian": "node scripts/catalog-guardian.mjs",
    "catalog:guardian:install:macos": "node scripts/install-catalog-guardian-macos.mjs",
    "catalog:guardian:uninstall:macos": "node scripts/uninstall-catalog-guardian-macos.mjs",
    "catalog:validate": "pnpm --filter @wow-trader/catalog dev validate",
    "companion:install:macos": "pnpm --filter @wow-trader/companion build && node scripts/install-companion-macos.mjs",
    "companion:uninstall:macos": "node scripts/uninstall-companion-macos.mjs",
    "desktop:dev": "pnpm --filter @wow-trader/desktop dev",
    "desktop:package": "pnpm --filter @wow-trader/desktop build",
    "desktop:make": "pnpm --filter @wow-trader/desktop make",
    "desktop:make:macos:x64": "pnpm --filter @wow-trader/desktop build:utility && pnpm --filter @wow-trader/desktop exec electron-forge make --platform=darwin --arch=x64 --targets=@electron-forge/maker-dmg",
    "desktop:make:macos:arm64": "pnpm --filter @wow-trader/desktop build:utility && pnpm --filter @wow-trader/desktop exec electron-forge make --platform=darwin --arch=arm64 --targets=@electron-forge/maker-dmg",
    "desktop:make:macos": "pnpm desktop:make:macos:x64 && pnpm desktop:make:macos:arm64",
    "desktop:make:windows": "pnpm --filter @wow-trader/desktop build:utility && pnpm --filter @wow-trader/desktop exec electron-forge make --platform=win32 --arch=x64 --targets=@electron-forge/maker-zip",
    "desktop:make:linux": "pnpm --filter @wow-trader/desktop build:utility && pnpm --filter @wow-trader/desktop exec electron-forge make --platform=linux --arch=x64 --targets=@electron-forge/maker-zip",
    "desktop:release": "pnpm desktop:make:macos && pnpm desktop:make:windows && pnpm desktop:make:linux && node scripts/prepare-companion-release.mjs",
    "desktop:release:macos": "pnpm desktop:make:macos && node scripts/prepare-companion-release.mjs --platforms=macos",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "deploy:production:nginx": "scripts/deploy-production-nginx.sh",
    "db:migrate": "pnpm --filter @wow-trader/db db:migrate",
    "dev": "node scripts/dev.mjs",
    "dev:setup": "node scripts/dev.mjs --bootstrap-only",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint scripts && node scripts/build-cache.mjs --run lint",
    "leveling:addon": "pnpm --filter @wow-trader/leveling addon",
    "leveling:addon:campaign": "pnpm --filter @wow-trader/leveling build && pnpm --filter @wow-trader/reference-data build && node scripts/build-leveling-campaign-addon.mjs",
    "leveling:feedback": "node scripts/leveling-feedback.mjs",
    "leveling:combat:import": "pnpm --filter @wow-trader/leveling build && node scripts/import-leveling-combat.mjs",
    "leveling:combat:audit": "pnpm --filter @wow-trader/leveling build && node scripts/audit-leveling-combat.mjs",
    "leveling:combat:review": "pnpm --filter @wow-trader/leveling build && node scripts/review-leveling-combat-evidence.mjs",
    "leveling:grind:review": "pnpm --filter @wow-trader/leveling build && node scripts/review-leveling-grind-evidence.mjs",
    "leveling:reward:review": "pnpm --filter @wow-trader/leveling build && node scripts/review-leveling-reward-evidence.mjs",
    "leveling:quest:review": "pnpm --filter @wow-trader/leveling build && node scripts/review-leveling-quest-validation.mjs",
    "leveling:quest:plan": "node scripts/leveling-quest-validation-plan.mjs",
    "leveling:xp:queue": "node scripts/leveling-quest-xp-queue.mjs",
    "leveling:xp:queue:archive": "node scripts/leveling-archive-xp-queue.mjs",
    "leveling:xp:status:archive": "node scripts/leveling-archive-xp-status.mjs",
    "leveling:xp:audit": "node scripts/audit-leveling-quest-xp.mjs",
    "leveling:evidence:queue": "node scripts/leveling-evidence-crawl-queue.mjs",
    "leveling:evidence:compile": "node scripts/leveling-quest-evidence.mjs",
    "leveling:xp:verify": "node scripts/audit-leveling-quest-xp.mjs --require-covered",
    "test": "node --test scripts/build-cache.test.mjs scripts/catalog-runtime.test.mjs scripts/leveling-evidence-crawl-queue.test.mjs scripts/leveling-quest-evidence.test.mjs scripts/leveling-quest-validation-plan.test.mjs scripts/review-leveling-combat-evidence.test.mjs scripts/review-leveling-grind-evidence.test.mjs scripts/review-leveling-reward-evidence.test.mjs scripts/review-leveling-quest-validation.test.mjs && node scripts/build-cache.mjs --run test",
    "typecheck": "node scripts/build-cache.mjs --run typecheck",
    "extract:tbc": "tools/extractor-dotnet/run-tbc-validation.sh",
    "extract:icons": "tools/extractor-dotnet/run-icon-extraction.sh",
    "forever:inspect": "pnpm --filter @wow-trader/forever-data dev inspect",
    "forever:import": "pnpm --filter @wow-trader/forever-data dev import",
    "forever:publish": "pnpm --filter @wow-trader/forever-data dev publish",
    "forever:sync": "pnpm --filter @wow-trader/forever-data dev sync",
    "forever:updates": "node packages/forever-data/dist/updates-cli.js",
    "simulator:prepare": "node scripts/prepare-forever-simulator.mjs",
    "simulator:import:references": "node scripts/import-simulator-reference-builds.mjs",
    "simulator:prebis:capture": "node scripts/capture-simulator-prebis.mjs",
    "simulator:prebis:baseline": "node scripts/capture-simulator-baseline.mjs",
    "simulator:prebis:refresh": "node scripts/refresh-simulator-baseline.mjs",
    "simulator:prebis:talents": "node scripts/optimize-simulator-talents.mjs",
    "simulator:prebis:probe-arms": "node scripts/probe-simulator-arms-policy.mjs",
    "simulator:prebis:stage-current": "node scripts/stage-simulator-current-prebis.mjs",
    "simulator:prebis:verify-current": "node scripts/verify-simulator-current-prebis.mjs",
    "simulator:prebis:verify-mcp": "node scripts/verify-simulator-mcp.mjs",
    "simulator:prebis:verify-drakkisath": "node scripts/verify-simulator-drakkisath.mjs",
    "simulator:prebis:stage-dungeon-mana": "node scripts/stage-simulator-dungeon-mana.mjs",
    "simulator:prebis:verify-dungeon-mana": "node scripts/verify-simulator-dungeon-mana.mjs",
    "simulator:prebis:audit-crafts": "node scripts/audit-simulator-craft-acquisition.mjs",
    "simulator:prebis:scenario": "node scripts/capture-simulator-consume-scenario.mjs",
    "simulator:prebis:proc-scenario": "node scripts/capture-simulator-proc-scenario.mjs",
    "simulator:prebis:proc-sensitivity": "node scripts/benchmark-simulator-proc-enchants.mjs",
    "simulator:prebis:review": "node scripts/review-simulator-feedback.mjs",
    "simulator:prebis:feedback": "node scripts/run-simulator-feedback.mjs",
    "simulator:prebis:update": "node scripts/update-simulator-prebis.mjs",
    "simulator:prebis:plan": "node scripts/update-simulator-prebis.mjs --plan",
    "simulator:prebis:status": "node scripts/update-simulator-prebis.mjs --status",
    "simulator:prebis:audit-rotation": "node scripts/audit-simulator-fury-rotation.mjs",
    "simulator:prebis:export": "node scripts/export-simulator-reviewed-build.mjs",
    "simulator:prebis:share": "node scripts/review-prebis-build.mjs",
    "simulator:prebis:share:test": "node --test scripts/review-prebis-build.test.mjs",
    "simulator:prebis:coverage": "node scripts/review-prebis-gear.mjs",
    "simulator:prebis:coverage:test": "node --test scripts/review-prebis-gear.test.mjs",
    "simulator:prebis:optimize": "node scripts/optimize-simulator-prebis.mjs --resume",
    "simulator:smoke": "node scripts/smoke-forever-simulator.mjs",
    "simulator:smoke:workspace": "node scripts/smoke-simulator-workspace.mjs",
    "simulator:smoke:inspection": "node scripts/smoke-simulator-inspection.mjs",
    "simulator:smoke:frame": "node scripts/smoke-simulator-frame.mjs",
    "simulator:smoke:defaults": "node scripts/smoke-simulator-defaults.mjs",
    "simulator:test": "node --test scripts/simulator-workspace.test.mjs scripts/simulator-tank-starters.test.mjs scripts/simulator-accessories.test.mjs scripts/simulator-inspection.test.mjs scripts/simulator-default-enchants.test.mjs scripts/simulator-trinkets.test.mjs scripts/simulator-prebis.test.mjs scripts/simulator-acquisition.test.mjs scripts/simulator-talents.test.mjs scripts/simulator-reference-builds.test.mjs scripts/simulator-search-cache.test.mjs scripts/simulator-craft-acquisition.test.mjs scripts/simulator-fury-rotations.test.mjs scripts/simulator-optimization-baselines.test.mjs scripts/simulator-prebis-enchants.test.mjs scripts/simulator-ownership.test.mjs scripts/simulator-prebis-consumes.test.mjs scripts/simulator-feedback.test.mjs scripts/simulator-feedback-workflow.test.mjs scripts/simulator-fury-rotation-audit.test.mjs scripts/simulator-seeds.test.mjs scripts/simulator-reviewed-build-export.test.mjs scripts/simulator-arms-policy.test.mjs scripts/simulator-talent-evidence.test.mjs scripts/simulator-item-effects.test.mjs scripts/simulator-current-prebis-staging.test.mjs scripts/simulator-current-prebis-admission.test.mjs scripts/simulator-proc-scenario.test.mjs scripts/simulator-dungeon-mana.test.mjs scripts/simulator-drakkisath.test.mjs scripts/simulator-talent-candidate.test.mjs scripts/simulator-campaign.test.mjs",
    "extract:forever:mechanics": "pnpm --filter @wow-trader/forever-data build && node scripts/extract-forever-mechanics.mjs",
    "forever:mechanics:import": "node scripts/import-forever-mechanics.mjs",
    "extract:forever:world": "tools/extractor-dotnet/run-forever-world-extraction.sh",
    "forever:addon-seeds": "node scripts/generate-forever-addon-seeds.mjs",
    "world:audit": "pnpm --filter @wow-trader/world-data dev audit",
    "world:import": "pnpm --filter @wow-trader/world-data dev import"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.5.1",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "3.2.7"
  }
}
