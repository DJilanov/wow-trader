{
  "name": "@wow-trader/desktop",
  "productName": "WoW Trader Companion",
  "version": "0.1.0",
  "private": true,
  "main": ".webpack/main",
  "description": "Background Auction House scan companion for WoW Trader",
  "author": "KFC Guild",
  "scripts": {
    "build:utility": "tsup --config tsup.utility.config.ts",
    "build": "pnpm build:utility && electron-forge package",
    "dev": "pnpm build:utility && WOW_TRADER_ENDPOINT=https://helper.kfcguild.online electron-forge start",
    "lint": "eslint src tsup.utility.config.ts forge.config.cjs webpack.*.config.cjs",
    "make": "pnpm build:utility && electron-forge make",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wow-trader/companion-core": "workspace:*",
    "electron-squirrel-startup": "1.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "css-loader": "7.1.5",
    "electron": "44.4.1",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "webpack": "5.111.0",
    "webpack-cli": "7.2.3"
  }
}
