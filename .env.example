DATABASE_URL=postgres://wow_trader:wow_trader@localhost:5432/wow_trader
REDIS_URL=redis://localhost:6379
RAW_UPLOAD_DIR=./raw-uploads
INGEST_API_HOST=127.0.0.1
INGEST_API_PORT=4000
INGEST_API_KEYS=replace-with-a-long-random-local-key
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
FOREVER_ASSET_ROOT=./artifacts/forever-preview-assets
LEVELING_ARCHIVE_ROOT=./artifacts/leveling/archive
LEVELING_COMBAT_ROOT=./artifacts/leveling/combat
COMPANION_RELEASE_ROOT=./artifacts/companion-releases
# Optional outside `pnpm dev`; item icon routes use separate roots because file-data IDs can differ
# between TBC and Forever builds.
WOW_TRADER_MEDIA_ROOT=
WOW_TRADER_FOREVER_MEDIA_ROOT=
# Optional. `pnpm dev` fills these automatically when WoW Forever Beta is installed.
FOREVER_WORLD_PRODUCT=wow_classic_beta
FOREVER_WORLD_LOCALE=enUS
FOREVER_WORLD_WOW_ROOT=/Applications/World of Warcraft
FOREVER_WORLD_OUTPUT=./artifacts/local-world
MARKET_READ_API_KEYS=
# Optional approved, checksum-verified external reference artifacts; never point this at staging.
WOW_TRADER_REFERENCE_DIRECTORY=
# Optional historical quest-XP fallback. Values remain labeled estimates and never replace a
# published Forever value or conflict.
WOW_TRADER_LEVELING_QUEST_XP_IMPORT=
# Optional audit-generated public coverage only; never point this at private observations.
WOW_TRADER_LEVELING_QUEST_VALIDATION_COVERAGE=
WOW_TRADER_LEVELING_QUEST_VALIDATION_COVERAGE_SHA256=
# Explicit reviewed runtime build if the guide/world source uses an older compatible build.
WOW_TRADER_LEVELING_RUNTIME_BUILD=
# Optional isolated local preview/build directory inside apps/web. Empty uses .next.
WOW_TRADER_BUILD_DIR=
# Versioned simulation assets, official notes and local current-client audit. Use absolute paths
# when running Next.js directly; pnpm dev resolves these automatically.
FOREVER_SIMULATOR_ROOT=
FOREVER_UPDATES_ROOT=
FOREVER_MECHANICS_ROOT=
FOREVER_ASSET_RELEASES_ROOT=

# Battle.net Game Data API. Create a dedicated client at
# https://community.developer.battle.net/access/clients and keep real values in ignored .env.local
# or .env. Never paste the client secret into chat, logs, issues, or tracked files.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# API region and the exact static namespace must match the target game edition.
BLIZZARD_API_REGION=eu
BLIZZARD_API_LOCALE=en_US
BLIZZARD_API_NAMESPACE=
