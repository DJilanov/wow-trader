{
  "name": "@wow-trader/forever-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./updates": {
      "types": "./dist/updates.d.ts",
      "import": "./dist/updates.js"
    },
    "./updates-server": {
      "types": "./dist/updates-server.d.ts",
      "import": "./dist/updates-server.js"
    },
    "./simulator": {
      "types": "./dist/simulator.d.ts",
      "import": "./dist/simulator.js"
    },
    "./healing-simulator": {
      "types": "./dist/healing-simulator.d.ts",
      "import": "./dist/healing-simulator.js"
    },
    "./druid-healing-simulator": {
      "types": "./dist/druid-healing-simulator.d.ts",
      "import": "./dist/druid-healing-simulator.js"
    },
    "./paladin-healing-simulator": {
      "types": "./dist/paladin-healing-simulator.d.ts",
      "import": "./dist/paladin-healing-simulator.js"
    },
    "./healer-workspace": {
      "types": "./dist/healer-workspace.d.ts",
      "import": "./dist/healer-workspace.js"
    },
    "./mechanics": {
      "types": "./dist/mechanics.d.ts",
      "import": "./dist/mechanics.js"
    },
    "./talent-sync": {
      "types": "./dist/talent-sync.d.ts",
      "import": "./dist/talent-sync.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/public.ts src/server.ts src/simulator.ts src/healing-simulator.ts src/druid-healing-simulator.ts src/paladin-healing-simulator.ts src/healer-workspace.ts src/mechanics.ts src/talent-sync.ts src/updates.ts src/updates-server.ts src/updates-cli.ts src/cli.ts --format esm --dts --sourcemap --clean",
    "dev": "tsx src/cli.ts",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wow-trader/db": "workspace:*",
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.2",
    "robots-parser": "3.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
