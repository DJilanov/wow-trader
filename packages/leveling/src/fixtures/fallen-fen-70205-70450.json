      "quests": {
        "95772": {
          "description": "Me brother tried draggin' me off tae the Wetlands with some diggin' crew out o' Loch Modan. Said they were headin' into hills no dwarf's ever set boot in for some sort o' excavation.\r\n\r\nAye, I'd 'ave gone, if I wasn't already behind on this pile o' girdles I've got to refit.\r\n\r\nDaewyn normally writes after he sends off, though. Haven't heard a thing, gives me a strange feelin' this time.\r\n\r\nIf yer marchin' that way, mind checking in on me brother?",
          "flags": 8,
          "level": 31,
          "minLevel": 24,
          "objectivesText": "Look for Dorin Songblade's brother, Daewyn, in Whelgar's Excavation Site.",
          "questInfoId": 81,
          "questType": 2,
          "raceMask": "ffffffffffffffff",
          "rewards": {
            "xpDifficulty": 6,
            "xpMultiplier": 1.95
          },
          "sources": 2,
          "title": "Songblade Search",
          "zoneAreaId": 16732
        },
        "95795": {
