DATABASE_URL=postgresql://wow_trader_web:replace-me@127.0.0.1:5432/wow_trader
WOW_TRADER_WEB_HOST=127.0.0.1
WOW_TRADER_WEB_PORT=19210
NODE_OPTIONS=--max-old-space-size=768
WOW_TRADER_MEDIA_ROOT=/home/wow-trader-system/shared/media/current
WOW_TRADER_FOREVER_MEDIA_ROOT=/home/wow-trader-system/shared/media/forever/current
FOREVER_ASSET_ROOT=/home/wow-trader-system/shared/forever-preview-assets/current
FOREVER_ASSET_RELEASES_ROOT=/home/wow-trader-system/shared/forever-preview-assets/releases
FOREVER_SIMULATOR_ROOT=/home/wow-trader-system/shared/forever-simulator
FOREVER_UPDATES_ROOT=/home/wow-trader-system/shared/forever-updates
FOREVER_MECHANICS_ROOT=/home/wow-trader-system/shared/forever-client-data
LEVELING_ARCHIVE_ROOT=/home/wow-trader-system/shared/leveling/releases/forever-guide-v2-70205-43b8ce0a
LEVELING_COMBAT_ROOT=/home/wow-trader-system/shared/leveling/combat
WOW_TRADER_REFERENCE_DIRECTORY=/home/wow-trader-reference-worker/shared/published
# Optional pinned historical fallback for fetched Forever pages without numeric XP.
WOW_TRADER_LEVELING_QUEST_XP_IMPORT=/home/wow-trader-reference-worker/shared/imports/quest-xp-import.json
# Optional public coverage from an approved current-build audit; both values are required.
WOW_TRADER_LEVELING_QUEST_VALIDATION_COVERAGE=
WOW_TRADER_LEVELING_QUEST_VALIDATION_COVERAGE_SHA256=
# Pin the reviewed runtime build separately from an older compatible source snapshot.
WOW_TRADER_LEVELING_RUNTIME_BUILD=
COMPANION_RELEASE_ROOT=/home/wow-trader-system/shared/companion-releases
WOW_TRADER_WORLD_SNAPSHOT=/home/wow-trader-system/shared/world-snapshots/current/manifest.json
WOW_TRADER_WORLD_MEDIA_ROOT=/home/wow-trader-system/shared/world-snapshots/current
WOW_TRADER_WORLD_PREFER_ARTIFACT=true
SEO_RUM_ENABLED=false
SEO_RUM_ROOT=/home/wow-trader-system/shared/seo/rum
SEO_RUM_BUILD=replace-with-release-id
SEO_RUM_SAMPLE_RATE=0.05
INDEXNOW_KEY=replace-with-8-to-128-letter-number-or-dash-key
